{
    "name": "survos/airnow-bundle",
    "description": "AirNow forecasts and observations for Symfony, using Survos Fetch for HTTP, retries and caching",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "survos/fetch-bundle": "^2.24.16",
        "survos/kit-bundle": "^2.24.16",
        "symfony/framework-bundle": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/validator": "^8.1"
    },
    "require-dev": {"phpunit/phpunit": "^13.0"},
    "autoload": {"psr-4": {"Survos\\AirNowBundle\\": "src/"}},
    "autoload-dev": {"psr-4": {"Survos\\AirNowBundle\\Tests\\": "tests/"}},
    "scripts": {"test": "phpunit"},
    "config": {"sort-packages": true}
}
